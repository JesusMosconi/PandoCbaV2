DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="cambiar-por-un-secreto-largo"
CORS_ORIGIN="http://localhost:3001"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Notificaciones por correo (Resend). Sin RESEND_API_KEY no se envía nada: solo se registra en consola.
RESEND_API_KEY=""
# Remitente. Sin dominio verificado en Resend solo se puede usar onboarding@resend.dev.
EMAIL_REMITENTE="PandoCBA <onboarding@resend.dev>"
# Secreto para firmar los enlaces de baja del newsletter (distinto de JWT_SECRET).
EMAIL_TOKEN_SECRET="cambiar-por-otro-secreto-largo"
# URL pública del frontend, usada para armar los enlaces de los correos.
FRONTEND_URL="http://localhost:3001"
# Correo de contacto que se muestra en el aviso de contraseña cambiada.
EMAIL_CONTACTO="contacto@ejemplo.com"
